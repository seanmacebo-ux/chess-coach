    "diag:bots": "tsx scripts/diag-bots.ts",
    "diag:floor": "tsx scripts/diag-floor.ts",
    "verify:policy": "tsx scripts/verify-policy.ts",
    "verify:endgames": "tsx scripts/verify-endgames.ts",
    "verify:positional": "tsx scripts/verify-positional.ts",
    "verify:openings": "tsx scripts/verify-openings.ts",
    "verify:breakdowns": "tsx scripts/verify-breakdowns.ts",
    "verify:middlegame": "tsx scripts/verify-middlegame.ts",
    "check:record": "node scripts/check-record.mjs",
    "verify:rating": "tsx scripts/verify-rating.ts",
    "sandbox:puzzles": "tsx scripts/sandbox-puzzles.ts",
    "sandbox:drills": "tsx scripts/sandbox-drills.ts",
