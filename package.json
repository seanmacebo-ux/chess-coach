    "dexie": "^4.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
