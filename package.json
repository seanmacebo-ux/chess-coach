    "build:tree": "tsx scripts/build-opening-tree.ts",
    "build:eco": "tsx scripts/build-eco.ts",
    "verify:eco": "tsx scripts/verify-eco.ts",
    "verify:history": "tsx scripts/verify-history.ts",
    "verify:material": "tsx scripts/verify-material.ts",
    "verify:redo": "tsx scripts/verify-redo.ts",
    "verify:theme": "tsx scripts/verify-theme.ts",
    "verify:contrast": "tsx scripts/verify-contrast.ts",
    "verify:style": "tsx scripts/verify-style.ts",
    "verify:game-breakdown": "tsx scripts/verify-game-breakdown.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "verify:tree": "tsx scripts/verify-tree.ts",
    "verify:report": "tsx scripts/verify-report.ts",
